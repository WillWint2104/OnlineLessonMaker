{
  "_": "APPROVED PAGE COMPOSITIONS — A PROPOSAL, awaiting the maintainer. Nothing here is wired into the shipping catalogue in docs/atlas/composition/src/, into the lesson, or into lesson-studio.html.",
  "theChain": "lesson intent → pattern → approved composition blueprint → spine, regions and rows → media geometry selects among the approved blueprints → content fills it. Never: content → measurements → slot sizes → hope the result looks balanced.",
  "theSpine": {
    "_": "THE ALIGNMENT PRIMITIVE, AND THE ONE OWNER OF THE ALIGNMENT RELATIONSHIP. A blueprint declares ONE spine per surface — an axis and a span. A row is then either on the spine or on the grid, and there is no third option.",
    "align: centre": "the spine is centred on the master grid, so the free columns either side are symmetric.",
    "align: left-edge": "the spine begins at column 1, so the free columns are all on the trailing side.",
    "row align: spine": "the row holds ONE named region and occupies the spine EXACTLY. The grid outside the spine is PAGE MARGIN: it is outside the active content spine, it needs no semantic owner, and it is valid. A row whose region is narrower than the spine is not a spine row.",
    "row align: grid": "the row names a split of the master grid and is an ACTIVE ROW. Every one of its columns must be owned by a region or declared as the symmetric containment of a centred split.",
    "whyItIsNotSixColumns": "A centred six-column spine and a six-column region at the left of a twelve-column active row occupy the same number of columns and are not the same thing. The first declares the page's axis and puts its margin outside the composition; the second leaves half of an active row unexplained. The spine primitive exists so the renderer cannot confuse them."
  },
  "whitespace": {
    "_": "THE FIVE SPACES, KEPT SEPARATE ON PURPOSE. They are not one thing and must never be solved by one generic whitespace rule, an occupancy fraction or a dead-space percentage.",
    "1 · page margin": "the grid outside the blueprint spine, and the symmetric containment of a centred grid row. Intentionally empty, valid, and it needs no semantic owner.",
    "2 · blueprint rhythm": "the named step between two semantic regions — tight / normal / section. Owned by the blueprint, rendered as a real grid row of exactly that height.",
    "3 · internal block space": "typography, the space between steps and equations, and the padding a visible surface needs. Owned by the BLOCK. It may never reach the exterior boundary of a semantic region, because that would silently add a second page-level rhythm value.",
    "4 · unclaimed composition space": "free width inside an ACTIVE ROW that no region owns. Always invalid. H2.",
    "5 · pair imbalance": "two regions that own all their width and still terminate too far apart. All width can be owned and the relationship still be visually invalid. H4, a SEPARATE contract from H2."
  },
  "ownership": {
    "_": "FROZEN. The boundary that stops rhythm being contaminated.",
    "block": [
      "typography",
      "spacing inside the component",
      "spacing between steps, equations and the like",
      "padding required by a VISIBLE surface"
    ],
    "blueprint": [
      "region placement",
      "columns and spans",
      "alignment and spines",
      "pairing",
      "ALL spacing between semantic regions"
    ],
    "rule": "A semantic region HUGS its meaningful ink or visible surface at its exterior boundary. Invisible component margin and padding must not add another page-level rhythm value. Measured by H10: a declared 56px section step must measure ~56px between the two regions."
  },
  "rhythm": {
    "steps": {
      "tight": 16,
      "normal": 32,
      "section": 56
    },
    "rule": "Every row but the last declares `gapAfter`. A gap may declare `gapWithin` to sit inside one region's columns, so a region that spans several rows is not cut by the rhythm beside it."
  },
  "rowModes": {
    "hug": "the row is exactly as tall as its contents; nothing stretches to match unrelated material.",
    "paired": "two siblings deliberately share a row on a declared `origin`, with a declared `imbalanceMax` and a `pairReason`. The atlas measures how far they actually terminate apart.",
    "workspace": "a row containing a region whose height is DESIGNED rather than derived — an interactive, a workbook page, a drawing surface. The one mode exempt from the pair-termination contract, and it must name the slot whose height is designed."
  },
  "golden": [
    "visual.explanation/spine-narrow",
    "worked.paired/cases-6-6"
  ],
