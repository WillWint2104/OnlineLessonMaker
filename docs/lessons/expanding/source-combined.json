  "slides": [
    {
      "type": "skill",
      "id": "binomial-products",
      "title": "Expanding two binomials",
      "description": "Expand two brackets systematically and collect like terms.",
      "video": {
        "url": "https://youtu.be/8cDC_Y2MKwA"
      },
      "activities": [
        {
          "id": "binomial-introduction",
          "title": "Introduction",
          "lede": "When two binomials are multiplied, every term in one bracket must multiply every term in the other bracket.",
          "introduction": {
            "why": "Expanding brackets rewrites a product as one polynomial expression and prepares you for later algebraic manipulation.",
            "keyIdea": "Every term in the first bracket multiplies every term in the second bracket.",
            "method": [
              "Distribute each term across the other bracket.",
              "Keep the sign attached to each term.",
              "Collect like terms."
            ],
            "illustration": "(_x_ + 2)(_x_ + 5) → _x_^2 + 7_x_ + 10"
          }
        },
        {
          "id": "binomial-video",
          "title": "Video",
          "optionalVideo": true,
          "lede": "Watch: expanding products of two brackets.",
          "focusPoints": [
            "How every term is distributed.",
            "How negative signs are handled.",
            "How like terms are collected at the end."
          ]
        },
        {
          "id": "binomial-positive",
          "title": "Positive terms",
          "workedExamples": [
            {
              "id": "binomial-positive-group",
              "type": "sequence",
              "title": "Positive terms",
              "examples": [
                {
                  "id": "binomial-positive-example",
                  "label": "Positive terms",
                  "prompt": "Expand and simplify (_x_ + 2)(_x_ + 5).",
                  "steps": [
                    {
                      "id": "binomial-positive-distribute",
                      "math": "_x_(_x_ + 5) + 2(_x_ + 5)",
                      "text": "Distribute both terms from the first bracket."
                    },
                    {
                      "id": "binomial-positive-expand",
                      "math": "_x_^2 + 5_x_ + 2_x_ + 10",
                      "text": "Expand each product."
                    },
                    {
                      "id": "binomial-positive-collect",
                      "math": "_x_^2 + 7_x_ + 10",
                      "text": "Collect the like terms."
                    }
                  ],
                  "answer": "(_x_ + 2)(_x_ + 5) = _x_^2 + 7_x_ + 10",
                  "solutionLayout": "paired-table",
                  "tabLabel": "Positive terms",
                  "resultLabel": "So"
                }
              ]
            }
          ]
        },
        {
          "id": "binomial-negative",
          "title": "A negative term",
          "workedExamples": [
            {
              "id": "binomial-negative-group",
              "type": "sequence",
              "title": "A negative term",
              "examples": [
                {
                  "id": "binomial-negative-example",
                  "label": "A negative term",
                  "prompt": "Expand and simplify (_x_ − 4)(_x_ + 3).",
                  "steps": [
                    {
                      "id": "binomial-negative-distribute",
                      "math": "_x_(_x_ + 3) − 4(_x_ + 3)",
                      "text": "Keep the negative sign with 4 when distributing."
                    },
                    {
                      "id": "binomial-negative-expand",
                      "math": "_x_^2 + 3_x_ − 4_x_ − 12",
                      "text": "Expand each product."
                    },
                    {
                      "id": "binomial-negative-collect",
                      "math": "_x_^2 − _x_ − 12",
                      "text": "Collect the like terms."
                    }
                  ],
                  "answer": "(_x_ − 4)(_x_ + 3) = _x_^2 − _x_ − 12",
                  "solutionLayout": "paired-table",
                  "tabLabel": "Negative term",
                  "resultLabel": "So"
                }
              ]
            }
          ]
        },
        {
          "id": "binomial-coefficients",
          "title": "Coefficients",
          "workedExamples": [
            {
              "id": "binomial-coefficients-group",
              "type": "sequence",
              "title": "Coefficients",
              "examples": [
                {
                  "id": "binomial-coefficients-example",
                  "label": "Coefficients",
                  "prompt": "Expand and simplify (2_x_ + 3)(_x_ − 5).",
                  "steps": [
                    {
                      "id": "binomial-coefficients-distribute",
                      "math": "2_x_(_x_ − 5) + 3(_x_ − 5)",
                      "text": "Distribute 2x and then 3 across the second bracket."
                    },
                    {
                      "id": "binomial-coefficients-expand",
                      "math": "2_x_^2 − 10_x_ + 3_x_ − 15",
                      "text": "Expand each product."
                    },
                    {
                      "id": "binomial-coefficients-collect",
                      "math": "2_x_^2 − 7_x_ − 15",
                      "text": "Collect the like terms."
                    }
                  ],
                  "answer": "(2_x_ + 3)(_x_ − 5) = 2_x_^2 − 7_x_ − 15",
                  "solutionLayout": "paired-table",
                  "tabLabel": "Coefficients",
                  "resultLabel": "So"
                }
              ]
            }
          ]
        },
        {
