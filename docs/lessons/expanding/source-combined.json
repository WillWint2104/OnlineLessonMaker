    {
      "type": "skill",
      "id": "binomial-trinomial-products",
      "title": "Expanding a binomial by a trinomial",
      "description": "Extend the same distribution process to three terms in the second bracket.",
      "video": {
        "url": "https://youtu.be/c17efvFF2as"
      },
      "activities": [
        {
          "id": "trinomial-introduction",
          "title": "Introduction",
          "lede": "The distributive law does not change when one bracket has three terms: each term in the binomial multiplies every term in the trinomial.",
          "introduction": {
            "why": "This extends bracket expansion to larger polynomial products without introducing a new method.",
            "keyIdea": "Each term in the binomial must multiply all three terms in the trinomial.",
            "method": [
              "Distribute the first term across the trinomial.",
              "Distribute the second term across the trinomial.",
              "Collect like terms."
            ],
            "illustration": "(_x_ + 2)(_x_^2 + 3_x_ + 4) → _x_^3 + 5_x_^2 + 10_x_ + 8"
          }
        },
        {
          "id": "trinomial-video",
          "title": "Video",
          "optionalVideo": true,
          "lede": "Watch: expanding products involving a trinomial.",
          "focusPoints": [
            "How each binomial term is distributed across all three trinomial terms.",
            "How powers and signs are kept organised.",
            "How like terms are collected at the end."
          ]
        },
        {
          "id": "trinomial-basic",
          "title": "Positive terms",
          "workedExamples": [
            {
              "id": "trinomial-basic-group",
              "type": "sequence",
              "title": "Positive terms",
              "examples": [
                {
                  "id": "trinomial-basic-example",
                  "label": "Positive terms",
                  "prompt": "Expand and simplify (_x_ + 2)(_x_^2 + 3_x_ + 4).",
                  "steps": [
                    {
                      "id": "trinomial-basic-distribute",
                      "math": "_x_(_x_^2 + 3_x_ + 4) + 2(_x_^2 + 3_x_ + 4)",
                      "text": "Distribute each binomial term across all three trinomial terms."
                    },
                    {
                      "id": "trinomial-basic-expand",
                      "math": "_x_^3 + 3_x_^2 + 4_x_ + 2_x_^2 + 6_x_ + 8",
                      "text": "Expand the six products."
                    },
                    {
                      "id": "trinomial-basic-collect",
                      "math": "_x_^3 + 5_x_^2 + 10_x_ + 8",
                      "text": "Collect like terms."
                    }
                  ],
                  "answer": "(_x_ + 2)(_x_^2 + 3_x_ + 4) = _x_^3 + 5_x_^2 + 10_x_ + 8",
                  "solutionLayout": "paired-table",
                  "tabLabel": "Positive terms",
                  "resultLabel": "So"
                }
              ]
            }
          ]
        },
        {
          "id": "trinomial-signs",
          "title": "Negative terms",
          "workedExamples": [
            {
              "id": "trinomial-signs-group",
              "type": "sequence",
              "title": "Negative terms",
              "examples": [
                {
                  "id": "trinomial-signs-example",
                  "label": "Negative terms",
                  "prompt": "Expand and simplify (_x_ − 3)(_x_^2 + 2_x_ − 5).",
                  "steps": [
                    {
                      "id": "trinomial-signs-distribute",
                      "math": "_x_(_x_^2 + 2_x_ − 5) − 3(_x_^2 + 2_x_ − 5)",
                      "text": "Keep the negative sign attached to 3 while distributing."
                    },
                    {
                      "id": "trinomial-signs-expand",
                      "math": "_x_^3 + 2_x_^2 − 5_x_ − 3_x_^2 − 6_x_ + 15",
                      "text": "Expand the six products."
                    },
                    {
                      "id": "trinomial-signs-collect",
                      "math": "_x_^3 − _x_^2 − 11_x_ + 15",
                      "text": "Collect like terms."
                    }
                  ],
                  "answer": "(_x_ − 3)(_x_^2 + 2_x_ − 5) = _x_^3 − _x_^2 − 11_x_ + 15",
                  "solutionLayout": "paired-table",
                  "tabLabel": "Negative terms",
                  "resultLabel": "So"
                }
              ]
            }
          ]
        },
        {
          "id": "trinomial-coefficients",
          "title": "Coefficients",
          "workedExamples": [
            {
              "id": "trinomial-coefficients-group",
              "type": "sequence",
              "title": "Coefficients",
              "examples": [
                {
                  "id": "trinomial-coefficients-example",
                  "label": "Coefficients",
                  "prompt": "Expand and simplify (2_x_ − 1)(_x_^2 − _x_ + 3).",
                  "steps": [
                    {
                      "id": "trinomial-coefficients-distribute",
                      "math": "2_x_(_x_^2 − _x_ + 3) − 1(_x_^2 − _x_ + 3)",
                      "text": "Distribute both terms across all three trinomial terms."
                    },
                    {
                      "id": "trinomial-coefficients-expand",
                      "math": "2_x_^3 − 2_x_^2 + 6_x_ − _x_^2 + _x_ − 3",
                      "text": "Expand the six products."
                    },
                    {
                      "id": "trinomial-coefficients-collect",
                      "math": "2_x_^3 − 3_x_^2 + 7_x_ − 3",
                      "text": "Collect like terms."
                    }
                  ],
                  "answer": "(2_x_ − 1)(_x_^2 − _x_ + 3) = 2_x_^3 − 3_x_^2 + 7_x_ − 3",
                  "solutionLayout": "paired-table",
                  "tabLabel": "Coefficients",
                  "resultLabel": "So"
                }
              ]
            }
          ]
        },
