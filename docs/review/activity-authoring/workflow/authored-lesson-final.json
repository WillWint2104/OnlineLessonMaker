          "title": "Find the signed pair",
          "notes": [
            {
              "term": "Reverse expansion",
              "body": "Find two integers whose product is −20 and sum is 1. Expand your brackets to check."
            }
          ]
        },
        {
          "id": "activity-aa9f471a-1658-4a38-a45b-50db33492e66",
          "title": "Factorise with opposite signs",
          "workedExamples": [
            {
              "id": "group-5188345f-0bc8-47bc-83f6-3d7c478ac82e",
              "type": "sequence",
              "title": "A complete method",
              "lede": "",
              "examples": [
                {
                  "id": "example-41f3bc3c-de29-4430-9d97-54c81f977947",
                  "label": "Factorise with opposite signs",
                  "prompt": "Factorise _x_^2 + _x_ − 20.",
                  "steps": [
                    {
                      "id": "step-d0d1ce51-f3c3-4d99-9dd2-e87cc6b60613",
                      "text": "Find a pair with product −20.",
                      "math": "5 × (−4) = −20",
                      "note": "Check both the product and the sum."
                    },
                    {
                      "id": "s2-l009",
                      "text": "Check the sum.",
                      "math": "5 + (−4) = 1"
                    },
                    {
                      "id": "s3-n403",
                      "text": "Write the factors.",
                      "math": "(_x_ + 5)(_x_ − 4)"
                    }
                  ],
                  "answer": "(_x_ + 5)(_x_ − 4)",
