          "notes": [
            {
              "term": "Product and sum",
              "body": "For 2_x_^2 + 5_x_ − 3, split 5_x_ into 6_x_ − _x_, then group."
            }
          ]
        },
        {
          "id": "activity-00357589-8159-4c00-ae0d-cdd48571a0af",
          "title": "Factorise a non-monic expression",
