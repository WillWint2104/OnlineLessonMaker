                  "id": "example-b896d9c4-5b1a-45d5-b03e-d16c4bb54121",
                  "label": "Factorise a non-monic expression",
                  "prompt": "Factorise 2_x_^2 + 5_x_ − 3.",
                  "steps": [
                    {
                      "id": "step-d213792f-6cc0-4a7d-afe8-06bac34fac70",
                      "text": "Multiply a and c.",
                      "math": "2 × (−3) = −6"
                    },
                    {
                      "id": "s2-y9cq",
                      "text": "Find the signed pair.",
                      "math": "6 + (−1) = 5"
                    },
                    {
                      "id": "s3-0zly",
                      "text": "Split and group.",
                      "math": "2_x_(_x_ + 3) − 1(_x_ + 3)"
                    },
                    {
                      "id": "s4-ci99",
                      "text": "Factor the common bracket.",
                      "math": "(2_x_ − 1)(_x_ + 3)"
                    }
                  ],
