          "title": "Split the middle term",
          "notes": [
            {
              "term": "Product and sum",
              "body": "For 2_x_^2 + 5_x_ − 3, split 5_x_ into 6_x_ − _x_, then group."
            }
          ]
        },
        {
          "id": "activity-9664835e-de11-47bc-aa85-f3349874ee34",
          "title": "Factorise a non-monic expression",
          "workedExamples": [
            {
              "id": "group-6f628fc6-cad4-4cea-8488-ebcaebeec3b9",
              "type": "sequence",
              "title": "A complete method",
              "lede": "",
              "examples": [
                {
                  "id": "example-87f05a58-a3ff-496d-ba92-372d6defb391",
                  "label": "Factorise a non-monic expression",
                  "prompt": "Factorise 2_x_^2 + 5_x_ − 3.",
                  "steps": [
                    {
                      "id": "step-efe6e7aa-eb4b-4797-9df0-38b4418e6c5e",
                      "text": "Multiply a and c.",
                      "math": "2 × (−3) = −6"
                    },
                    {
                      "id": "s2-kllm",
                      "text": "Find the signed pair.",
                      "math": "6 + (−1) = 5"
                    },
                    {
                      "id": "s3-a0rx",
                      "text": "Split and group.",
                      "math": "2_x_(_x_ + 3) − 1(_x_ + 3)"
                    },
                    {
                      "id": "s4-2j80",
                      "text": "Factor the common bracket.",
                      "math": "(2_x_ − 1)(_x_ + 3)"
                    }
                  ],
                  "answer": "(2_x_ − 1)(_x_ + 3)",
