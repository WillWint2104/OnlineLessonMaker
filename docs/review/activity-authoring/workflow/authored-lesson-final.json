              "id": "group-1f58571b-7f6f-43b3-b7f6-71402fbf876a",
              "type": "sequence",
              "title": "A complete method",
              "lede": "",
              "examples": [
                {
                  "id": "example-6750f023-eb9f-4323-9732-dbef86bb1046",
                  "label": "Factorise with opposite signs",
                  "prompt": "Factorise _x_^2 + _x_ − 20.",
                  "steps": [
                    {
                      "id": "step-14474782-2d21-485a-be93-8fdcbd1f69c9",
                      "text": "Find a pair with product −20.",
                      "math": "5 × (−4) = −20",
                      "note": "Check both the product and the sum."
                    },
                    {
                      "id": "s2-u8o7",
                      "text": "Check the sum.",
                      "math": "5 + (−4) = 1"
                    },
                    {
                      "id": "s3-ufrq",
                      "text": "Write the factors.",
                      "math": "(_x_ + 5)(_x_ − 4)"
                    }
                  ],
                  "answer": "(_x_ + 5)(_x_ − 4)",
