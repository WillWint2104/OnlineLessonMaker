              "title": "A complete method",
              "lede": "",
              "examples": [
                {
                  "id": "example-18654c4a-c700-47b3-a9c2-9a1cc3ba66e8",
                  "label": "Factorise with opposite signs",
                  "prompt": "Factorise _x_^2 + _x_ − 20.",
                  "steps": [
                    {
                      "id": "step-a98b42f5-cf4c-43cd-a3b9-90afb38cb64e",
                      "text": "Find a pair with product −20.",
                      "math": "5 × (−4) = −20",
                      "note": "Check both the product and the sum."
                    },
                    {
                      "id": "s2-sujl",
                      "text": "Check the sum.",
                      "math": "5 + (−4) = 1"
                    },
                    {
                      "id": "s3-x38w",
                      "text": "Write the factors.",
                      "math": "(_x_ + 5)(_x_ − 4)"
                    }
                  ],
                  "answer": "(_x_ + 5)(_x_ − 4)",
