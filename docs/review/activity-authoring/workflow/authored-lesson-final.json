              "examples": [
                {
                  "id": "example-41233121-5893-4c51-8aee-675860e01daa",
                  "label": "Factorise a non-monic expression",
                  "prompt": "Factorise 2_x_^2 + 5_x_ − 3.",
                  "steps": [
                    {
                      "id": "step-dda1323d-fb07-4314-b027-c0a3895b399d",
                      "text": "Multiply a and c.",
                      "math": "2 × (−3) = −6"
                    },
                    {
                      "id": "s2-vdm5",
                      "text": "Find the signed pair.",
                      "math": "6 + (−1) = 5"
                    },
                    {
                      "id": "s3-892u",
                      "text": "Split and group.",
                      "math": "2_x_(_x_ + 3) − 1(_x_ + 3)"
                    },
                    {
                      "id": "s4-hq9s",
                      "text": "Factor the common bracket.",
                      "math": "(2_x_ − 1)(_x_ + 3)"
                    }
                  ],
                  "answer": "(2_x_ − 1)(_x_ + 3)",
