          "title": "Find the signed pair",
          "notes": [
            {
              "term": "Reverse expansion",
              "body": "Find two integers whose product is −20 and sum is 1. Expand your brackets to check."
            }
          ]
        },
        {
          "id": "activity-688c4c8d-1366-490e-858c-f3856195dbde",
          "title": "Factorise with opposite signs",
          "workedExamples": [
