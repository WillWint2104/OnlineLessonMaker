                  "label": "Negative terms",
                  "prompt": "Expand and simplify (_x_ − 3)(_x_^2 + 2_x_ − 5).",
                  "steps": [
                    {
                      "id": "trinomial-signs-distribute",
                      "math": "_x_(_x_^2 + 2_x_ − 5) − 3(_x_^2 + 2_x_ − 5)",
                      "text": "Keep the negative sign attached to 3 while distributing."
                    },
                    {
                      "id": "trinomial-signs-expand",
                      "math": "_x_^3 + 2_x_^2 − 5_x_ − 3_x_^2 − 6_x_ + 15",
                      "text": "Expand the six products."
                    },
                    {
                      "id": "trinomial-signs-collect",
                      "math": "_x_^3 − _x_^2 − 11_x_ + 15",
                      "text": "Collect like terms."
                    }
                  ],
                  "answer": "(_x_ − 3)(_x_^2 + 2_x_ − 5) = _x_^3 − _x_^2 − 11_x_ + 15",
                  "solutionLayout": "paired-table",
                  "tabLabel": "Negative terms",
                  "resultLabel": "So"
                }
              ]
            }
          ]
        },
