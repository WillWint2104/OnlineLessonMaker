    {
      "type": "skill",
      "id": "nonmonic",
      "title": "Factorising non-monic quadratics",
      "video": {
        "url": ""
      },
      "activities": [
        {
          "id": "nonmonic-explain",
          "title": "Split the middle term",
          "notes": [
            {
              "id": "reverse",
              "term": "The reverse of expanding",
              "body": "Expanding turns (_x_ + 2)(_x_ + 3) into _x_^2 + 5_x_ + 6. Factorising turns it back. If your factors expand to the original, you are right."
            },
            {
              "id": "monic",
              "term": "Monic",
              "body": "A quadratic is monic when the coefficient of _x_^2 is 1 — _x_^2 + _b__x_ + _c_."
            },
            {
              "id": "nonmonic",
              "term": "Non-monic",
              "body": "A quadratic is non-monic when the coefficient of _x_^2 is not 1 — _a__x_^2 + _b__x_ + _c_ with _a_ ≠ 1."
            },
            {
              "id": "sumproduct",
              "term": "Sum and product",
              "body": "For a monic quadratic, find two numbers that MULTIPLY to _c_ and ADD to _b_. Those two numbers go straight into the brackets."
            },
            {
              "id": "common",
              "term": "Common factor first",
              "body": "Always look for a common factor before anything else. 2_x_^2 + 10_x_ + 12 becomes 2(_x_^2 + 5_x_ + 6), and the bracket is now monic."
            },
            {
              "id": "signs",
              "term": "Reading the signs",
              "body": "If _c_ is positive, both numbers share the sign of _b_. If _c_ is negative, one number is positive and one is negative."
            }
          ]
        },
        {
          "id": "nonmonic-video",
          "title": "Watch and connect the method",
          "optionalVideo": true
        },
        {
          "id": "nonmonic-ex-n1",
          "title": "Both signs positive",
          "workedExamples": [
            {
              "id": "g-nonmonic",
              "type": "sequence",
              "title": "Both signs positive",
              "lede": "",
              "examples": [
                {
                  "id": "ex-n1",
                  "label": "Both signs positive",
                  "prompt": "Factorise 2_x_^2 + 7_x_ + 3.",
                  "steps": [
                    {
                      "id": "n1s1",
                      "text": "There is no common factor, and the leading coefficient is not 1. Multiply the first and last coefficients.",
                      "math": "_a_ × _c_ = 2 × 3 = 6"
                    },
                    {
                      "id": "n1s2",
                      "text": "Find two numbers that multiply to 6 and add to the middle coefficient, 7.",
                      "math": "1 × 6 = 6,   1 + 6 = 7"
                    },
                    {
                      "id": "n1s3",
                      "text": "Split the middle term into those two terms. The order does not matter.",
                      "math": "2_x_^2 + _x_ + 6_x_ + 3"
                    },
                    {
                      "id": "n1s4",
                      "text": "Group in pairs and factorise each pair.",
                      "math": "_x_(2_x_ + 1) + 3(2_x_ + 1)"
                    },
                    {
                      "id": "n1s5",
                      "text": "The bracket (2_x_ + 1) is common to both. Take it out.",
                      "math": "(2_x_ + 1)(_x_ + 3)"
                    }
                  ],
                  "answer": "2_x_^2 + 7_x_ + 3 = (2_x_ + 1)(_x_ + 3)"
                }
              ]
            }
          ]
        },
        {
          "id": "nonmonic-ex-n2",
          "title": "Both signs negative",
          "workedExamples": [
            {
              "id": "g-nonmonic",
              "type": "sequence",
              "title": "Both signs negative",
              "lede": "",
              "examples": [
                {
                  "id": "ex-n2",
                  "label": "Both signs negative",
                  "prompt": "Factorise 6_x_^2 − 11_x_ + 3.",
                  "steps": [
                    {
                      "id": "n2s1",
                      "text": "Multiply the first and last coefficients.",
                      "math": "_a_ × _c_ = 6 × 3 = 18"
                    },
                    {
                      "id": "n2s2",
                      "text": "The product is positive and the middle term is negative, so both numbers are negative.",
                      "math": "(−2) × (−9) = 18,   (−2) + (−9) = −11"
                    },
                    {
                      "id": "n2s3",
                      "text": "Split the middle term.",
                      "math": "6_x_^2 − 2_x_ − 9_x_ + 3"
                    },
                    {
                      "id": "n2s4",
                      "text": "Group and factorise each pair. Take out −3 from the second pair so the bracket matches.",
                      "math": "2_x_(3_x_ − 1) − 3(3_x_ − 1)"
                    },
                    {
                      "id": "n2s5",
                      "text": "Take out the common bracket.",
                      "math": "(3_x_ − 1)(2_x_ − 3)"
                    }
                  ],
                  "answer": "6_x_^2 − 11_x_ + 3 = (3_x_ − 1)(2_x_ − 3). Taking out +3 instead of −3 in step 4 leaves two different brackets — that is the signal to go back one line."
                }
              ]
            }
          ]
        },
        {
          "id": "nonmonic-ex-n3",
          "title": "Mixed signs",
          "workedExamples": [
            {
              "id": "g-nonmonic",
              "type": "sequence",
              "title": "Mixed signs",
              "lede": "",
              "examples": [
                {
                  "id": "ex-n3",
                  "label": "Mixed signs",
                  "prompt": "Factorise 2_x_^2 − 5_x_ − 3.",
                  "steps": [
                    {
                      "id": "n3s1",
                      "text": "Multiply the first and last coefficients. The product is negative, so the two numbers have different signs.",
                      "math": "_a_ × _c_ = 2 × (−3) = −6"
                    },
                    {
                      "id": "n3s2",
                      "text": "Find the pair that adds to −5.",
                      "math": "1 × (−6) = −6,   1 + (−6) = −5"
                    },
                    {
                      "id": "n3s3",
                      "text": "Split the middle term.",
                      "math": "2_x_^2 + _x_ − 6_x_ − 3"
                    },
                    {
                      "id": "n3s4",
                      "text": "Group and factorise each pair.",
                      "math": "_x_(2_x_ + 1) − 3(2_x_ + 1)"
                    },
                    {
                      "id": "n3s5",
                      "text": "Take out the common bracket, then check by expanding.",
                      "math": "(2_x_ + 1)(_x_ − 3)"
                    }
                  ],
                  "answer": "2_x_^2 − 5_x_ − 3 = (2_x_ + 1)(_x_ − 3)"
                }
              ]
            }
          ]
        },
