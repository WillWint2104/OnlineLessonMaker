        {
          "id": "trinomial-introduction",
          "title": "Introduction",
          "lede": "The distributive law does not change when one bracket has three terms: each term in the binomial multiplies every term in the trinomial.",
          "introduction": {
            "why": "This extends bracket expansion to larger polynomial products without introducing a new method.",
            "keyIdea": "Each term in the binomial must multiply all three terms in the trinomial.",
            "method": [
              "Distribute the first term across the trinomial.",
              "Distribute the second term across the trinomial.",
              "Collect like terms."
            ],
            "illustration": "(_x_ + 2)(_x_^2 + 3_x_ + 4) → _x_^3 + 5_x_^2 + 10_x_ + 8"
          }
        },
        {
          "id": "trinomial-video",
          "title": "Video",
          "optionalVideo": true,
          "lede": "Watch: expanding products involving a trinomial.",
          "focusPoints": [
            "How each binomial term is distributed across all three trinomial terms.",
            "How powers and signs are kept organised.",
            "How like terms are collected at the end."
          ]
        },
