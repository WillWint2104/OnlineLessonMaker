                  "label": "Worked example",
                  "tabLabel": "Reverse a bracket",
                  "prompt": "Simplify $\\frac{b-a}{a-b}$.",
                  "solutionLayout": "paired-table",
                  "steps": [
                    {
                      "id": "opposites-basic-step-1",
                      "math": "$b-a=-(a-b)$",
                      "text": "Factor out −1 to reverse the subtraction."
                    },
                    {
                      "id": "opposites-basic-step-2",
                      "math": "$\\frac{b-a}{a-b}=-\\frac{a-b}{a-b}$",
                      "text": "The same non-zero factor now appears above and below."
                    },
                    {
                      "id": "opposites-basic-step-3",
                      "math": "$=-1$",
                      "text": "Cancel the common factor and keep the negative."
                    }
                  ],
                  "answer": "$-1$",
