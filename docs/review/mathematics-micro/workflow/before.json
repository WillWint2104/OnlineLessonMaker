    {
      "type": "skill",
      "id": "reversed-brackets",
      "title": "Cancelling when the brackets are reversed",
      "description": "Factor out −1 to reverse subtraction order and create matching factors.",
      "video": {
        "url": "https://youtu.be/bcyZjCbvUfM?si=hMY99tX6IGZEkU2V"
      },
      "activities": [
        {
          "id": "reversed-introduction",
          "title": "Introduction",
          "lede": "Two binomials such as _a_ − _b_ and _b_ − _a_ contain the same terms in the opposite order.",
          "notes": [
            {
              "term": "The key rewrite",
              "body": "_b_ − _a_ = −(_a_ − _b_). Factoring out −1 reverses the subtraction."
            },
            {
              "term": "Why it helps",
              "body": "Once the brackets match exactly, a common factor can be cancelled or opposite denominators can be combined."
            },
            {
              "term": "Do not lose the negative",
              "body": "The factor −1 remains after the matching bracket is cancelled."
            }
          ],
          "introduction": {
            "why": "This technique can turn an algebraic fraction that appears not to cancel into one with an obvious common factor.",
            "keyIdea": "_b_ − _a_ = −(_a_ − _b_).",
            "method": [
              "Look for the same two terms in the opposite order.",
              "Factor out −1 from one bracket.",
              "Rewrite so the brackets match.",
              "Cancel or combine only after the rewrite.",
              "Keep any remaining negative factor."
            ],
            "illustration": "(_b_ − _a_)/(_a_ − _b_) = −(_a_ − _b_)/(_a_ − _b_) = −1"
          }
        },
        {
          "id": "reversed-video",
          "title": "Video",
          "optionalVideo": true,
          "lede": "Watch: cancelling when the brackets are reversed.",
          "focusPoints": [
            "How factoring out −1 reverses a bracket.",
            "Why the negative remains after cancellation.",
            "When factorisation is needed before cancellation.",
            "How opposite denominators can be rewritten before combining fractions."
          ]
        },
        {
          "id": "opposites-basic",
          "title": "Opposite binomials",
          "workedExamples": [
            {
              "id": "opposites-basic-group",
              "type": "sequence",
              "title": "Opposite binomials",
              "examples": [
                {
                  "id": "opposites-basic-example",
                  "label": "Opposite binomials",
                  "tabLabel": "Reverse the bracket",
                  "prompt": "Simplify (_b_ − _a_)/(_a_ − _b_).",
                  "solutionLayout": "paired-table",
                  "steps": [
                    {
                      "id": "opposites-basic-step-1",
                      "math": "_b_ − _a_ = −(_a_ − _b_)",
                      "text": "Factor out −1 so the bracket order matches."
                    },
                    {
                      "id": "opposites-basic-step-2",
                      "math": "(_b_ − _a_)/(_a_ − _b_) = −(_a_ − _b_)/(_a_ − _b_)",
                      "text": "The same factor now appears above and below."
                    },
                    {
                      "id": "opposites-basic-step-3",
                      "math": "= −1",
                      "text": "Cancel the common bracket and keep the negative factor."
                    }
                  ],
                  "answer": "−1",
                  "resultLabel": "So"
                }
              ]
            }
          ]
        },
        {
          "id": "difference-squares",
          "title": "Difference of squares",
          "workedExamples": [
            {
              "id": "difference-squares-group",
              "type": "sequence",
              "title": "Difference of squares",
              "examples": [
                {
                  "id": "difference-squares-example",
                  "label": "Difference of squares",
                  "tabLabel": "Factor first",
                  "prompt": "Simplify (_v_^2 − _u_^2)/(_u_ − _v_).",
                  "solutionLayout": "paired-table",
                  "steps": [
                    {
                      "id": "difference-squares-step-1",
                      "math": "_v_^2 − _u_^2 = (_v_ + _u_)(_v_ − _u_)",
                      "text": "Factor the difference of squares."
                    },
                    {
                      "id": "difference-squares-step-2",
                      "math": "_v_ − _u_ = −(_u_ − _v_)",
                      "text": "Reverse the factor by taking out −1."
                    },
                    {
                      "id": "difference-squares-step-3",
                      "math": "= −(_v_ + _u_)",
                      "text": "Cancel the matching factor and keep the negative."
                    }
                  ],
                  "answer": "−(_v_ + _u_)",
                  "resultLabel": "So"
                }
              ]
            }
          ]
        },
        {
          "id": "quadratic-factor",
          "title": "Quadratic factorisation",
          "workedExamples": [
            {
              "id": "quadratic-factor-group",
              "type": "sequence",
              "title": "Quadratic factorisation",
              "examples": [
                {
                  "id": "quadratic-factor-example",
                  "label": "Quadratic factorisation",
                  "tabLabel": "Factor the quadratic",
                  "prompt": "Simplify (_x_^2 − 5_x_ + 6)/(2 − _x_).",
                  "solutionLayout": "paired-table",
                  "steps": [
                    {
                      "id": "quadratic-factor-step-1",
                      "math": "−2 + (−3) = −5\n(−2)(−3) = 6",
                      "text": "Find the pair used to factor the quadratic."
                    },
                    {
                      "id": "quadratic-factor-step-2",
                      "math": "_x_^2 − 5_x_ + 6 = (_x_ − 2)(_x_ − 3)",
                      "text": "Factorise the numerator."
                    },
                    {
                      "id": "quadratic-factor-step-3",
                      "math": "_x_ − 2 = −(2 − _x_)",
                      "text": "Reverse the factor that matches the denominator."
                    },
                    {
                      "id": "quadratic-factor-step-4",
                      "math": "= −(_x_ − 3)",
                      "text": "Cancel the matching factor and keep the negative."
                    }
                  ],
                  "answer": "−(_x_ − 3)",
                  "resultLabel": "So"
                }
              ]
            }
          ]
        },
        {
          "id": "subtract-opposite",
          "title": "Subtracting opposite denominators",
          "workedExamples": [
            {
              "id": "subtract-opposite-group",
              "type": "sequence",
              "title": "Subtracting opposite denominators",
              "examples": [
                {
                  "id": "subtract-opposite-example",
                  "label": "Subtracting opposite denominators",
                  "tabLabel": "Subtraction",
                  "prompt": "Simplify 1/(_a_ − _b_) − 1/(_b_ − _a_).",
                  "solutionLayout": "paired-table",
                  "steps": [
                    {
                      "id": "subtract-opposite-step-1",
                      "math": "_b_ − _a_ = −(_a_ − _b_)",
                      "text": "Rewrite the second denominator."
                    },
                    {
                      "id": "subtract-opposite-step-2",
                      "math": "1/(_a_ − _b_) − 1/[−(_a_ − _b_)] = 1/(_a_ − _b_) + 1/(_a_ − _b_)",
                      "text": "The subtraction of a negative fraction becomes addition."
                    },
                    {
                      "id": "subtract-opposite-step-3",
                      "math": "= 2/(_a_ − _b_)",
                      "text": "Combine the numerators."
                    }
                  ],
                  "answer": "2/(_a_ − _b_)",
                  "resultLabel": "So"
                }
              ]
            }
          ]
        },
        {
          "id": "add-opposite",
          "title": "Adding opposite denominators",
          "workedExamples": [
            {
              "id": "add-opposite-group",
              "type": "sequence",
              "title": "Adding opposite denominators",
              "examples": [
                {
                  "id": "add-opposite-example",
                  "label": "Adding opposite denominators",
                  "tabLabel": "Addition",
                  "prompt": "Simplify _m_/(_m_ − _n_) + _n_/(_n_ − _m_).",
                  "solutionLayout": "paired-table",
                  "steps": [
                    {
                      "id": "add-opposite-step-1",
                      "math": "_n_ − _m_ = −(_m_ − _n_)",
                      "text": "Rewrite the second denominator."
                    },
                    {
                      "id": "add-opposite-step-2",
                      "math": "_m_/(_m_ − _n_) + _n_/[−(_m_ − _n_)] = _m_/(_m_ − _n_) − _n_/(_m_ − _n_)",
                      "text": "The second fraction becomes negative."
                    },
                    {
                      "id": "add-opposite-step-3",
                      "math": "= (_m_ − _n_)/(_m_ − _n_) = 1",
                      "text": "Combine the numerators and cancel."
                    }
                  ],
                  "answer": "1",
                  "resultLabel": "So"
                }
              ]
            }
          ]
        },
