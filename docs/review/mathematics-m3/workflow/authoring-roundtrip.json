                  "id": "graph-method-example",
                  "label": "Construct and compare",
                  "tabLabel": "Graph methods",
                  "prompt": "Plot $y=2x+1$.",
                  "steps": [
                    {
                      "id": "graph-step-0",
                      "math": "x=0: y=1",
                      "text": "Find the intercept."
                    },
                    {
                      "id": "graph-step-1",
                      "math": "x=1: y=3",
                      "text": "Find a second point."
                    },
                    {
                      "id": "graph-step-2",
                      "math": "(0,1), (1,3)",
                      "text": "Use both points to determine the straight line."
                    }
                  ],
                  "answer": "y=2x+1"
                }
              ]
            }
          ]
