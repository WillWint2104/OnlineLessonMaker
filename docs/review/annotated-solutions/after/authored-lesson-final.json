      "activities": [
        {
          "id": "nonmonic-ex-n2",
          "title": "Split, group and factor",
          "workedExamples": [
            {
              "id": "g-nonmonic",
              "type": "sequence",
              "title": "Both signs negative",
              "lede": "",
              "examples": [
                {
                  "id": "ex-n2",
                  "label": "Split, group and factor",
                  "prompt": "Factorise 6_x_^2 − 11_x_ + 3.",
                  "steps": [
                    {
                      "id": "n2s1",
                      "math": "_a_ × _c_ = 6 × 3 = 18\n_m_ + _n_ = −11",
                      "text": "The split coefficients need product 18 and sum −11. Both must be negative: their product is positive and their sum is negative."
                    },
                    {
                      "id": "n2s2",
                      "math": "18 ÷ 1 = 18 → (1, 18)\n18 ÷ 2 = 9 → (2, 9)\n18 ÷ 3 = 6 → (3, 6)\n(−2) × (−9) = 18\n−2 + (−9) = −11",
                      "text": "The divisors 4 and 5 fail; 6 reverses (3, 6). Apply the negative signs and compare the sums to select −2 and −9.",
                      "visual": [
                        {
                          "kind": "table",
                          "stub": "Negative pair",
                          "head": [
                            "Product",
                            "Sum"
                          ],
                          "rows": [
                            [
                              "(−1, −18)",
                              "18",
                              "−19"
                            ],
                            [
                              "(−2, −9)",
                              "18",
                              "−11"
                            ],
                            [
                              "(−3, −6)",
                              "18",
                              "−9"
                            ]
                          ]
                        }
                      ]
                    },
                    {
                      "id": "n2s3",
                      "math": "6_x_^2 − 11_x_ + 3\n= 6_x_^2 − 2_x_ − 9_x_ + 3",
                      "text": "Split −11x into −2x − 9x. Their sum leaves the expression unchanged."
                    },
                    {
                      "id": "n2s4",
                      "math": "= 2_x_(3_x_ − 1) − 3(3_x_ − 1)",
                      "text": "Take out 2x from the first pair and −3 from the second pair. Both brackets are now 3x − 1.",
                      "note": "Taking out +3 gives −3x + 1 in the second bracket; use the negative common factor so the brackets match."
                    },
                    {
                      "id": "n2s5",
                      "math": "= (3_x_ − 1)(2_x_ − 3)",
                      "text": "Factor out the common bracket 3x − 1."
                    },
                    {
                      "id": "nonmonic-check",
                      "math": "(3_x_ − 1)(2_x_ − 3) = 6_x_^2 − 9_x_ − 2_x_ + 3\n= 6_x_^2 − 11_x_ + 3",
                      "text": "Check the factorisation by expansion. The two middle terms combine to −11x."
                    }
                  ],
                  "answer": ""
                }
              ]
            }
          ],
          "lede": "There is no common factor other than 1. The leading coefficient is 6, so search using the product of the first and last coefficients."
        },
