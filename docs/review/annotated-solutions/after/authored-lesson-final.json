      "activities": [
        {
          "id": "monic-ex-pp",
          "title": "Find the positive factor pair",
          "workedExamples": [
            {
              "id": "g-signs",
              "type": "sequence",
              "title": "Both signs positive",
              "lede": "",
              "examples": [
                {
                  "id": "ex-pp",
                  "label": "Find the positive factor pair",
                  "prompt": "Factorise _x_^2 + 7_x_ + 12.",
                  "steps": [
                    {
                      "id": "s1",
                      "math": "_m_ × _n_ = 12\n_m_ + _n_ = 7",
                      "text": "The constant gives the product; the coefficient of x gives the sum. A positive product and positive sum require two positive numbers."
                    },
                    {
                      "id": "s2",
                      "math": "12 ÷ 1 = 12 → (1, 12)\n12 ÷ 2 = 6 → (2, 6)\n12 ÷ 3 = 4 → (3, 4)",
                      "text": "Try positive divisors in order. Trying 4 next gives (4, 3), reversing the last pair; every later successful divisor also reverses a pair already recorded."
                    },
                    {
                      "id": "s3",
                      "math": "3 × 4 = 12\n3 + 4 = 7",
                      "text": "Compare the sums of all three distinct pairs. Only 3 and 4 meet both requirements.",
                      "visual": [
                        {
                          "kind": "table",
                          "stub": "Pair",
                          "head": [
                            "Product",
                            "Sum"
                          ],
                          "rows": [
                            [
                              "(1, 12)",
                              "12",
                              "13"
                            ],
                            [
                              "(2, 6)",
                              "12",
                              "8"
                            ],
                            [
                              "(3, 4)",
                              "12",
                              "7"
                            ]
                          ]
                        }
                      ]
                    },
                    {
                      "id": "s4",
                      "math": "_x_^2 + 7_x_ + 12 = (_x_ + 3)(_x_ + 4)",
                      "text": "Put the selected numbers into the two brackets."
                    },
                    {
                      "id": "positive-check",
                      "math": "(_x_ + 3)(_x_ + 4) = _x_^2 + 4_x_ + 3_x_ + 12\n= _x_^2 + 7_x_ + 12",
                      "text": "Check by expanding. The combined middle terms and the constant reproduce the original expression."
                    }
                  ],
                  "answer": ""
                }
              ]
            }
          ],
          "lede": "There is no common factor other than 1. The coefficient of x² is 1, so use the monic product-and-sum method."
        },
        {
          "id": "activity-aa9f471a-1658-4a38-a45b-50db33492e66",
          "title": "Choose signs after finding magnitudes",
          "workedExamples": [
            {
              "id": "group-5188345f-0bc8-47bc-83f6-3d7c478ac82e",
              "type": "sequence",
              "title": "A complete method",
              "lede": "",
              "examples": [
                {
                  "id": "example-41f3bc3c-de29-4430-9d97-54c81f977947",
                  "label": "Choose signs after finding magnitudes",
                  "prompt": "Factorise _x_^2 + _x_ − 20.",
                  "steps": [
                    {
                      "id": "step-d0d1ce51-f3c3-4d99-9dd2-e87cc6b60613",
                      "math": "_m_ × _n_ = −20\n_m_ + _n_ = 1",
                      "text": "The constant is negative, so the numbers have opposite signs. The sum is positive, so the number with the larger absolute value must be positive."
                    },
                    {
                      "id": "s2-l009",
                      "math": "20 ÷ 1 = 20 → (1, 20)\n20 ÷ 2 = 10 → (2, 10)\n20 = 3 × 6 + 2\n20 ÷ 4 = 5 → (4, 5)",
                      "text": "Test magnitudes in order. The remainder rejects 3 as a divisor. Trying 5 reverses (4, 5), so stop: the distinct magnitude pairs have all been found."
                    },
                    {
                      "id": "s3-n403",
                      "math": "5 × (−4) = −20\n5 + (−4) = 1",
                      "text": "Compare the restricted candidates: −4 and 5 satisfy both the product and sum.",
                      "visual": [
                        {
                          "kind": "table",
                          "stub": "Candidates after sign restriction",
                          "head": [
                            "Product",
                            "Sum"
                          ],
                          "rows": [
                            [
                              "(−1, 20)",
                              "−20",
                              "19"
                            ],
                            [
                              "(−2, 10)",
                              "−20",
                              "8"
                            ],
                            [
                              "(−4, 5)",
                              "−20",
                              "1"
                            ]
                          ]
                        }
                      ],
                      "note": "Check the sign on each number."
                    },
                    {
                      "id": "mixed-factor",
                      "math": "_x_^2 + _x_ − 20 = (_x_ − 4)(_x_ + 5)",
                      "text": "Use the selected signed numbers. Reversing the order of the factors gives the same product."
                    },
                    {
                      "id": "mixed-check",
                      "math": "(_x_ − 4)(_x_ + 5) = _x_^2 + 5_x_ − 4_x_ − 20\n= _x_^2 + _x_ − 20",
                      "text": "Expand and collect like terms to check the original quadratic."
                    }
                  ],
                  "answer": ""
                }
              ]
            }
          ],
          "lede": "Factorise x² + x − 20. Search the magnitudes first, then use the signs to narrow the candidates."
        },
