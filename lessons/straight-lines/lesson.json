    {
      "id": "gradient",
      "type": "skill",
      "title": "Gradient",
      "video": {
        "url": ""
      },
      "activities": [
        {
          "id": "gradient-intro",
          "title": "Introduction",
          "lede": "Gradient measures the vertical change for each unit of horizontal change.",
          "introduction": {
            "why": "Gradient lets you compare rates of change and steepness.",
            "keyIdea": "_m_ = rise/run = (change in _y_)/(change in _x_). Positive rises, negative falls, and zero is horizontal; a vertical line has undefined gradient.",
            "method": [
              "Choose two distinct points.",
              "Find the changes in y and x in the same order.",
              "Divide the change in y by the change in x."
            ]
          }
        },
        {
          "id": "gradient-video",
          "title": "Video",
          "optionalVideo": true,
          "lede": "Watch: gradient.",
          "focusPoints": [
            "Connect the rule with the graph.",
            "Follow the working, then try the examples."
          ]
        },
        {
          "id": "gradient-rising",
          "title": "A rising line",
          "workedExamples": [
            {
              "id": "gradient-rising-group",
              "type": "sequence",
              "title": "A rising line",
              "examples": [
                {
                  "id": "gradient-rising-example",
                  "label": "A rising line",
                  "tabLabel": "Rise and run",
                  "prompt": "Find the gradient through A(1, 2) and B(4, 8).",
                  "solutionLayout": "paired-table",
                  "steps": [
                    {
                      "id": "rise",
                      "math": "8 − 2 = 6",
                      "text": "Find the vertical change from A to B."
                    },
                    {
                      "id": "run",
                      "math": "4 − 1 = 3",
                      "text": "Find the change in x in the same order."
                    },
                    {
                      "id": "gradient",
                      "math": "_m_ = 6/3 = 2",
                      "text": "Divide rise by run."
                    }
                  ],
                  "answer": "_m_ = 2",
                  "visual": [
                    {
                      "kind": "figure",
                      "figure": {
                        "type": "figure",
                        "figure": "graph",
                        "title": "A rising line: y = 2x",
                        "caption": "A rising line: y = 2x",
                        "aspect": "equal",
                        "grid": "shown",
                        "callouts": "shown",
                        "curveLabels": "shown",
                        "domain": {
                          "xMin": -1,
                          "xMax": 5,
                          "yMin": -2,
                          "yMax": 10
                        },
                        "objects": [
                          {
                            "type": "function",
                            "f": "2x",
                            "label": "y = 2x",
                            "pen": "solid"
                          },
                          {
                            "type": "points",
                            "from": "table",
                            "rows": [
                              [
                                "A",
                                1,
                                2
                              ],
                              [
                                "B",
                                4,
                                8
                              ]
                            ]
                          }
                        ]
                      }
                    }
                  ],
                  "visualPlacement": "question",
                  "support": {
                    "title": "Why does any pair work?",
                    "introduction": "A straight line has a constant rate of change.",
                    "steps": [
                      {
                        "id": "support-rise",
                        "math": "(8 − 2)/(4 − 1) = 2",
                        "text": "Use the same point order in numerator and denominator."
                      },
                      {
                        "id": "support-check",
                        "math": "(2 − 8)/(1 − 4) = 2",
                        "text": "Reversing both changes leaves the quotient unchanged."
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "gradient-signs",
          "title": "Falling and horizontal lines",
          "workedExamples": [
            {
              "id": "gradient-signs-group",
              "type": "sequence",
              "title": "Falling and horizontal lines",
              "examples": [
                {
                  "id": "gradient-signs-example",
                  "label": "Falling and horizontal lines",
                  "tabLabel": "Negative and zero",
                  "prompt": "Find the gradients of y = −x + 3 and y = 1.",
                  "solutionLayout": "paired-table",
                  "steps": [
                    {
                      "id": "fall",
                      "math": "_m_ = (0 − 3)/(3 − 0) = −1",
                      "text": "The falling line drops 1 for each step right."
                    },
                    {
                      "id": "flat",
                      "math": "_m_ = (1 − 1)/(3 − 0) = 0",
                      "text": "The horizontal line has no vertical change."
                    }
                  ],
                  "answer": "The gradients are −1 and 0.",
                  "visual": [
                    {
                      "kind": "figure",
                      "figure": {
                        "type": "figure",
                        "figure": "graph",
                        "title": "Solid: y = −x + 3; dashed: y = 1",
                        "caption": "Solid: y = −x + 3; dashed: y = 1",
                        "aspect": "equal",
                        "grid": "shown",
                        "callouts": "shown",
                        "curveLabels": "shown",
                        "domain": {
                          "xMin": -1,
                          "xMax": 5,
                          "yMin": -2,
                          "yMax": 5
                        },
                        "objects": [
                          {
                            "type": "function",
                            "f": "-x+3",
                            "label": "y = −x + 3",
                            "pen": "solid"
                          },
                          {
                            "type": "function",
                            "f": "1",
                            "label": "y = 1",
                            "pen": "dashed"
                          },
                          {
                            "type": "points",
                            "from": "table",
                            "rows": [
                              [
                                "A",
                                0,
                                3
                              ],
                              [
                                "B",
                                3,
                                0
                              ]
                            ]
                          }
                        ]
                      }
                    }
                  ],
                  "visualPlacement": "question"
                }
              ]
            }
          ]
        },
        {
          "id": "gradient-steepness",
          "title": "Compare steepness",
          "workedExamples": [
            {
              "id": "gradient-steepness-group",
              "type": "sequence",
              "title": "Compare steepness",
              "examples": [
                {
                  "id": "gradient-steepness-example",
                  "label": "Compare steepness",
                  "tabLabel": "Steepness",
                  "prompt": "Which is steeper: y = 2x + 1 or y = −x/2 + 1?",
                  "solutionLayout": "paired-table",
                  "steps": [
                    {
                      "id": "read",
                      "math": "_m_ = 2 or −1/2",
                      "text": "Read the coefficient of x in each rule."
                    },
                    {
                      "id": "compare",
                      "math": "|2| > |−1/2|",
                      "text": "Compare the magnitudes on equal-scale axes."
                    }
                  ],
                  "answer": "y = 2x + 1 is steeper.",
                  "visual": [
                    {
                      "kind": "figure",
                      "figure": {
                        "type": "figure",
                        "figure": "graph",
                        "title": "Solid: y = 2x + 1; dashed: y = −x/2 + 1",
                        "caption": "Solid: y = 2x + 1; dashed: y = −x/2 + 1",
                        "aspect": "equal",
                        "grid": "shown",
                        "callouts": "shown",
                        "curveLabels": "shown",
                        "domain": {
                          "xMin": -3,
                          "xMax": 3,
                          "yMin": -5,
                          "yMax": 7
                        },
                        "objects": [
                          {
                            "type": "function",
                            "f": "2x+1",
                            "label": "y = 2x + 1",
                            "pen": "solid"
                          },
                          {
                            "type": "function",
                            "f": "-x/2+1",
                            "label": "y = −x/2 + 1",
                            "pen": "dashed"
                          }
                        ]
                      }
                    }
                  ],
                  "visualPlacement": "question"
                }
              ]
            }
          ]
        },
