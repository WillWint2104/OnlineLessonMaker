        {
          "id": "intercept-table",
          "title": "Read a rule from a table",
          "workedExamples": [
            {
              "id": "intercept-table-group",
              "type": "sequence",
              "title": "Read a rule from a table",
              "examples": [
                {
                  "id": "intercept-table-example",
                  "label": "Read a rule from a table",
