    {
      "id": "rule-graph",
      "type": "skill",
      "title": "From rule to graph",
      "video": {
        "url": ""
      },
      "activities": [
        {
          "id": "rule-graph-intro",
          "title": "Introduction",
          "lede": "A rule gives every point on a straight line; two distinct points determine it.",
          "introduction": {
            "why": "A graph makes a constant rate of change visible.",
            "keyIdea": "Use a table, or start at (0, _c_) and move using _m_. Choose equal-scale axes and respect the stated x-domain.",
            "method": [
              "Read the gradient and intercept.",
              "Calculate useful points within the domain.",
              "Plot and join them, then check another point."
            ]
          }
        },
        {
          "id": "rule-graph-video",
          "title": "Video",
          "optionalVideo": true,
          "lede": "Watch: from rule to graph.",
          "focusPoints": [
            "Connect the rule with the graph.",
            "Follow the working, then try the examples."
          ]
        },
        {
          "id": "rule-table",
          "title": "Plot from a table",
          "workedExamples": [
            {
              "id": "rule-table-group",
              "type": "sequence",
              "title": "Plot from a table",
              "examples": [
                {
                  "id": "rule-table-example",
                  "label": "Plot from a table",
                  "tabLabel": "Table to graph",
                  "prompt": "Draw y = 2x − 1 for −2 ≤ x ≤ 3.",
                  "solutionLayout": "paired-table",
                  "steps": [
                    {
                      "id": "values",
                      "math": "_x_ = −2: _y_ = 2(−2) − 1 = −5",
                      "text": "Substitute each chosen x-value."
                    },
                    {
                      "id": "plot",
                      "math": "(−2, −5), (0, −1), (3, 5)",
                      "text": "Plot the pairs on equal-scale axes."
                    },
                    {
                      "id": "join",
                      "math": "−2 ≤ _x_ ≤ 3",
                      "text": "Join the points only across the stated domain."
                    }
                  ],
                  "answer": "A straight segment from (−2, −5) to (3, 5).",
                  "visual": [
                    {
                      "kind": "figure",
                      "figure": {
                        "type": "figure",
                        "figure": "graph",
                        "title": "y = 2x − 1 on the authored domain −2 ≤ x ≤ 3",
                        "caption": "y = 2x − 1 on the authored domain −2 ≤ x ≤ 3",
                        "aspect": "equal",
                        "grid": "shown",
                        "callouts": "shown",
                        "curveLabels": "shown",
                        "domain": {
                          "xMin": -2,
                          "xMax": 3,
                          "yMin": "-6",
                          "yMax": 6
                        },
                        "objects": [
                          {
                            "type": "points",
                            "from": "table",
                            "rows": [
                              [
                                "A",
                                -2,
                                -5
                              ],
                              [
                                "B",
                                0,
                                -1
                              ],
                              [
                                "C",
                                3,
                                5
                              ]
                            ]
                          },
                          {
                            "type": "segment",
                            "between": [
                              "A",
                              "C"
                            ]
                          }
                        ]
                      }
                    },
                    {
                      "kind": "table",
                      "label": "Checked table of values for y = 2x − 1",
                      "stub": "_x_",
                      "head": [
                        "−2",
                        "−1",
                        "0",
                        "1",
                        "2",
                        "3"
                      ],
                      "rows": [
                        {
                          "label": "_y_",
                          "cells": [
                            "−5",
                            "−3",
                            "−1",
                            "1",
                            "3",
                            "5"
                          ]
                        }
                      ]
                    }
                  ],
                  "visualPlacement": "question"
                }
              ]
            }
          ]
        },
        {
          "id": "rule-gradient",
          "title": "Plot from gradient and intercept",
          "workedExamples": [
            {
              "id": "rule-gradient-group",
              "type": "sequence",
              "title": "Plot from gradient and intercept",
              "examples": [
                {
                  "id": "rule-gradient-example",
                  "label": "Plot from gradient and intercept",
                  "tabLabel": "Intercept and slope",
                  "prompt": "Draw y = −x/2 + 2 for −2 ≤ x ≤ 4.",
                  "solutionLayout": "paired-table",
                  "steps": [
                    {
                      "id": "read",
                      "math": "_m_ = −1/2, _c_ = 2",
                      "text": "Start at the y-intercept (0, 2)."
                    },
                    {
                      "id": "move",
                      "math": "(0, 2) → (2, 1) → (4, 0)",
                      "text": "Move right 2 and down 1 each time."
                    },
                    {
