        {
          "id": "intercept-rule",
          "title": "Read the y-intercept",
          "workedExamples": [
            {
              "id": "intercept-rule-group",
              "type": "sequence",
              "title": "Read the y-intercept",
              "examples": [
                {
                  "id": "intercept-rule-example",
                  "label": "Read the y-intercept",
                  "tabLabel": "From a rule",
                  "prompt": "Find the y-intercept of y = −2x + 3.",
                  "solutionLayout": "paired-table",
                  "steps": [
                    {
                      "id": "set-zero",
                      "math": "_x_ = 0",
                      "text": "Every point on the y-axis has x = 0."
                    },
                    {
                      "id": "substitute",
                      "math": "_y_ = −2(0) + 3 = 3",
                      "text": "Substitute zero into the rule."
                    }
                  ],
                  "answer": "The y-intercept is 3, at (0, 3).",
                  "visual": [
                    {
                      "kind": "figure",
