      "activities": [
        {
          "id": "intercept-intro",
          "title": "Introduction",
          "lede": "The y-intercept is the y-value where a line crosses the y-axis.",
          "introduction": {
            "why": "It gives a starting point for drawing the line.",
            "keyIdea": "In _y_ = _m__x_ + _c_, _m_ is the gradient and _c_ is the y-intercept; the crossing point is (0, _c_).",
            "method": [
              "Set x = 0 or locate the y-axis.",
              "Find the corresponding y-value.",
              "Write the intercept and its coordinate."
            ]
          }
        },
        {
          "id": "intercept-video",
          "title": "Video",
          "optionalVideo": true,
          "lede": "Watch: the y-intercept.",
