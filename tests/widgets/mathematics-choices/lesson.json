            {
              "id": "choice-fractions",
              "archetypeId": "method-choice",
              "level": "basic",
              "stem": "Calculate $\\frac12+\\frac13$.",
              "presentation": "compact",
              "choice": {
                "type": "single",
                "options": [
                  {
                    "id": "fractions-a",
                    "text": "$\\frac25$"
                  },
                  {
                    "id": "fractions-b",
                    "text": "$\\frac56$"
                  },
                  {
                    "id": "fractions-c",
                    "text": "$\\frac16$"
                  },
                  {
                    "id": "fractions-d",
                    "text": "$\\frac23$"
                  }
                ]
              },
              "choiceAnswer": {
                "correctOptionIds": [
                  "fractions-b"
                ]
              },
              "workedSolution": {
                "steps": [
                  {
                    "id": "fractions-step-0",
                    "math": "\\frac12+\\frac13=\\frac36+\\frac26",
                    "text": "Use the common denominator 6."
                  },
                  {
                    "id": "fractions-step-1",
                    "math": "\\frac36+\\frac26=\\frac56",
                    "text": "Add the numerators."
                  }
                ]
              },
              "releaseGroup": "foundation-a",
              "extensions": {
                "review": "preserved"
              }
            },
            {
              "id": "choice-equivalent",
              "archetypeId": "method-choice",
              "level": "basic",
              "stem": "Which fractions are equivalent to $\\frac34$?",
              "presentation": "compact",
              "choice": {
                "type": "multiple",
                "options": [
                  {
                    "id": "equivalent-a",
                    "text": "$\\frac68$"
                  },
                  {
                    "id": "equivalent-b",
                    "text": "$\\frac9{12}$"
                  },
                  {
                    "id": "equivalent-c",
                    "text": "$\\frac38$"
                  },
                  {
                    "id": "equivalent-d",
                    "text": "$\\frac{12}{20}$"
                  }
                ]
              },
              "choiceAnswer": {
                "correctOptionIds": [
                  "equivalent-a",
                  "equivalent-b"
                ]
              },
              "workedSolution": {
                "steps": [
                  {
                    "id": "equivalent-step-0",
                    "math": "\\frac68=\\frac34",
                    "text": "Divide numerator and denominator by 2."
                  },
                  {
                    "id": "equivalent-step-1",
                    "math": "\\frac9{12}=\\frac34",
                    "text": "Divide numerator and denominator by 3."
                  },
                  {
                    "id": "equivalent-step-2",
                    "math": "\\frac{12}{20}=\\frac35",
                    "text": "This is not three quarters."
                  }
                ]
              },
              "releaseGroup": "foundation-a",
              "extensions": {
                "review": "preserved"
              }
            },
            {
              "id": "choice-roots",
              "archetypeId": "method-choice",
              "level": "basic",
              "stem": "Find the positive square root $\\sqrt{49}$.",
              "presentation": "compact",
              "choice": {
                "type": "single",
                "options": [
                  {
                    "id": "roots-a",
                    "text": "$-7$"
                  },
                  {
                    "id": "roots-b",
                    "text": "$7$"
                  },
                  {
                    "id": "roots-c",
                    "text": "$14$"
                  },
                  {
                    "id": "roots-d",
                    "text": "$24.5$"
                  }
                ]
              },
              "choiceAnswer": {
                "correctOptionIds": [
                  "roots-b"
                ]
              },
              "workedSolution": {
                "steps": [
                  {
                    "id": "roots-step-0",
                    "math": "7^2=49",
                    "text": "The positive square root is 7."
                  }
                ]
              },
              "releaseGroup": "foundation-a",
              "extensions": {
                "review": "preserved"
              }
            },
            {
              "id": "choice-factorisation",
              "archetypeId": "method-choice",
              "level": "moderate",
              "stem": "Choose the factorisation of $x^2+5x+6$.",
              "presentation": "compact",
              "choice": {
                "type": "single",
                "options": [
                  {
                    "id": "factorisation-a",
                    "text": "$(x+1)(x+6)$"
                  },
                  {
                    "id": "factorisation-b",
                    "text": "$(x-2)(x-3)$"
                  },
                  {
                    "id": "factorisation-c",
                    "text": "$(x+2)(x+3)$"
                  },
                  {
                    "id": "factorisation-d",
                    "text": "$(x+5)(x+1)$"
                  }
                ]
              },
              "choiceAnswer": {
                "correctOptionIds": [
                  "factorisation-c"
                ]
              },
              "workedSolution": {
                "steps": [
                  {
                    "id": "factorisation-step-0",
                    "math": "2+3=5",
                    "text": "The two constants must add to 5."
                  },
                  {
                    "id": "factorisation-step-1",
                    "math": "2\\times3=6",
                    "text": "Their product must be 6."
                  },
                  {
                    "id": "factorisation-step-2",
                    "math": "x^2+5x+6=(x+2)(x+3)",
                    "text": "Both checks are satisfied."
                  }
                ]
              },
              "releaseGroup": "moderate-b",
              "extensions": {
                "review": "preserved"
              }
            },
            {
              "id": "choice-primes",
              "archetypeId": "method-choice",
              "level": "moderate",
              "stem": "Which of these numbers are prime?",
              "presentation": "compact",
              "choice": {
                "type": "multiple",
                "options": [
                  {
                    "id": "primes-a",
                    "text": "$2$"
                  },
                  {
                    "id": "primes-b",
                    "text": "$4$"
                  },
                  {
                    "id": "primes-c",
                    "text": "$5$"
                  },
                  {
                    "id": "primes-d",
                    "text": "$9$"
                  }
                ]
              },
              "choiceAnswer": {
                "correctOptionIds": [
                  "primes-a",
                  "primes-c"
                ]
              },
              "workedSolution": {
                "steps": [
                  {
                    "id": "primes-step-0",
                    "math": "4=2\\times2",
                    "text": "4 is composite."
                  },
                  {
                    "id": "primes-step-1",
                    "math": "9=3\\times3",
                    "text": "9 is composite."
                  },
                  {
                    "id": "primes-step-2",
                    "text": "2 and 5 each have exactly two positive divisors."
                  }
                ]
              },
              "releaseGroup": "moderate-b",
              "extensions": {
                "review": "preserved"
              }
            },
            {
              "id": "choice-coordinates",
              "archetypeId": "method-choice",
              "level": "moderate",
              "stem": "Which points lie on the line $y=2x+1$?",
              "presentation": "compact",
              "choice": {
                "type": "multiple",
                "options": [
                  {
                    "id": "coordinates-a",
                    "text": "$(0,1)$"
                  },
                  {
                    "id": "coordinates-b",
                    "text": "$(1,3)$"
                  },
                  {
                    "id": "coordinates-c",
                    "text": "$(2,4)$"
                  },
                  {
                    "id": "coordinates-d",
                    "text": "$(-1,-1)$"
                  }
                ]
              },
              "choiceAnswer": {
                "correctOptionIds": [
                  "coordinates-a",
                  "coordinates-b",
                  "coordinates-d"
                ]
              },
              "workedSolution": {
                "steps": [
                  {
                    "id": "coordinates-step-0",
                    "math": "2(0)+1=1",
                    "text": "The point (0,1) lies on the line."
                  },
                  {
                    "id": "coordinates-step-1",
                    "math": "2(1)+1=3",
                    "text": "The point (1,3) lies on the line."
                  },
                  {
                    "id": "coordinates-step-2",
                    "math": "2(2)+1=5",
                    "text": "At x=2 the y-value is 5, not 4."
                  },
                  {
                    "id": "coordinates-step-3",
                    "math": "2(-1)+1=-1",
                    "text": "The point (-1,-1) lies on the line."
                  }
                ]
              },
              "releaseGroup": "moderate-b",
              "extensions": {
                "review": "preserved"
              }
            },
            {
              "id": "choice-distribution",
              "archetypeId": "method-choice",
              "level": "moderate",
              "stem": "A learner wrote $2(x+3)=2x+3$. Which correction is valid?",
              "presentation": "compact",
              "choice": {
                "type": "single",
                "options": [
                  {
                    "id": "distribution-a",
                    "text": "$2(x+3)=2x+5$"
                  },
                  {
                    "id": "distribution-b",
                    "text": "$2(x+3)=2x+6$"
                  },
                  {
                    "id": "distribution-c",
                    "text": "$2(x+3)=x+6$"
                  },
                  {
                    "id": "distribution-d",
                    "text": "$2(x+3)=2x+3$"
                  }
                ]
              },
              "choiceAnswer": {
                "correctOptionIds": [
                  "distribution-b"
                ]
              },
              "workedSolution": {
                "steps": [
                  {
                    "id": "distribution-step-0",
                    "math": "2(x+3)=2x+2\\times3",
                    "text": "Multiply both bracket terms by 2."
                  },
                  {
                    "id": "distribution-step-1",
                    "math": "2x+2\\times3=2x+6",
                    "text": "Simplify the constant term."
                  }
                ]
              },
              "releaseGroup": "moderate-b",
              "extensions": {
                "review": "preserved"
              }
            }
          ]
        }
