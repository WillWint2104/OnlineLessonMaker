                {
                  "id": "structural-method",
                  "label": "Worked example",
                  "tabLabel": "Matrix addition",
                  "prompt": "Given $A=\\begin{pmatrix}1&2\\\\3&4\\end{pmatrix}$ and $B=\\begin{pmatrix}2&0\\\\-1&3\\end{pmatrix}$, find $A+B$.",
                  "solutionLayout": "paired-table",
                  "steps": [
                    {
                      "id": "entry-rule",
                      "math": "$A+B=\\begin{pmatrix}(1+2)&(2+0)\\\\(3-1)&(4+3)\\end{pmatrix}$",
                      "text": "Add entries in corresponding positions. Both matrices have two rows and two columns."
                    },
                    {
                      "id": "entry-result",
                      "math": "$A+B=\\begin{pmatrix}3&2\\\\2&7\\end{pmatrix}$",
                      "text": "Keep the row and column positions unchanged."
                    }
                  ],
                  "answer": "$\\begin{pmatrix}3&2\\\\2&7\\end{pmatrix}$",
                  "practice": {
                    "instructions": "Complete the questions in your exercise book or the authored workbook. This is an audit fixture."
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "practice-structural",
          "title": "Structural notation",
          "practiceCollectionId": "collection-structural",
          "questions": [
            {
              "id": "matrix",
              "archetypeId": "structural-method",
              "level": "basic",
              "presentation": "extended",
              "stem": "Find $A+B$ for $A=\\begin{pmatrix}1&2\\\\3&4\\end{pmatrix}$ and $B=\\begin{pmatrix}2&0\\\\-1&3\\end{pmatrix}$.",
              "answer": "$\\begin{pmatrix}3&2\\\\2&7\\end{pmatrix}$",
              "workedSolution": {
                "steps": [
                  {
                    "id": "matrix-step-0",
                    "math": "A+B=\\begin{pmatrix}(1+2)&(2+0)\\\\(3-1)&(4+3)\\end{pmatrix}",
                    "text": "Add corresponding entries."
                  },
                  {
                    "id": "matrix-step-1",
                    "math": "A+B=\\begin{pmatrix}3&2\\\\2&7\\end{pmatrix}",
                    "text": "The result remains a 2 by 2 matrix."
                  }
                ]
              }
            },
            {
              "id": "determinant",
              "archetypeId": "structural-method",
              "level": "basic",
              "presentation": "extended",
              "stem": "Evaluate $\\begin{vmatrix}2&3\\\\1&4\\end{vmatrix}$.",
              "answer": "$5$",
              "workedSolution": {
                "steps": [
                  {
                    "id": "determinant-step-0",
                    "math": "\\begin{vmatrix}2&3\\\\1&4\\end{vmatrix}=2\\times4-3\\times1",
                    "text": "For a 2 by 2 determinant, subtract the product on the other diagonal."
                  },
                  {
                    "id": "determinant-step-1",
                    "math": "8-3=5",
                    "text": "Subtract the two diagonal products to obtain the determinant."
                  }
                ]
              }
            },
            {
              "id": "vector",
              "archetypeId": "structural-method",
              "level": "basic",
              "presentation": "extended",
              "stem": "Given $\\vec{u}=\\begin{pmatrix}2\\\\-3\\end{pmatrix}$ and $\\vec{v}=\\begin{pmatrix}-1\\\\5\\end{pmatrix}$, find $\\vec{u}+\\vec{v}$.",
              "answer": "$\\begin{pmatrix}1\\\\2\\end{pmatrix}$",
              "workedSolution": {
                "steps": [
                  {
                    "id": "vector-step-0",
                    "math": "\\vec{u}+\\vec{v}=\\begin{pmatrix}2-1\\\\-3+5\\end{pmatrix}",
                    "text": "Add corresponding vector components."
                  },
                  {
                    "id": "vector-step-1",
                    "math": "\\vec{u}+\\vec{v}=\\begin{pmatrix}1\\\\2\\end{pmatrix}",
                    "text": "The two components stay in a single column."
                  }
                ]
              }
            },
            {
              "id": "piecewise",
              "archetypeId": "structural-method",
              "level": "basic",
              "presentation": "extended",
              "stem": "Let $f(x)=\\begin{cases}x^2 & x\\ge0\\\\-x & \\text{otherwise}\\end{cases}$. Find $f(-2)$ and $f(3)$.",
              "answer": "$f(-2)=2$ and $f(3)=9$.",
              "workedSolution": {
                "steps": [
                  {
                    "id": "piecewise-step-0",
                    "math": "f(-2)=-(-2)=2",
                    "text": "Use the otherwise branch because negative two is not nonnegative."
                  },
                  {
                    "id": "piecewise-step-1",
                    "math": "f(3)=3^2=9",
                    "text": "Three satisfies the first condition."
                  }
                ]
              }
            },
            {
              "id": "sets",
              "archetypeId": "structural-method",
              "level": "basic",
              "presentation": "extended",
              "stem": "Write $\\{x\\in\\mathbb{R}:-2\\le x<3\\}$ in interval notation.",
              "answer": "$[-2,3)$",
              "workedSolution": {
                "steps": [
                  {
                    "id": "sets-step-0",
                    "math": "-2\\le x<3",
                    "text": "Include negative two and exclude three."
                  },
                  {
                    "id": "sets-step-1",
                    "math": "x\\in[-2,3)",
                    "text": "The closed left fence includes the endpoint; the open right fence excludes it."
                  }
                ]
              }
            },
            {
              "id": "determinant-3",
              "archetypeId": "structural-method",
              "level": "basic",
              "presentation": "extended",
              "stem": "Evaluate $\\begin{vmatrix}1&2&3\\\\0&1&4\\\\5&6&0\\end{vmatrix}$.",
              "answer": "$1$",
              "workedSolution": {
                "steps": [
                  {
                    "id": "determinant-3-step-0",
                    "math": "\\begin{vmatrix}1&2&3\\\\0&1&4\\\\5&6&0\\end{vmatrix}=1(0-24)-2(0-20)+3(0-5)",
                    "text": "Expand along the first row, preserving alternating signs."
                  },
                  {
                    "id": "determinant-3-step-1",
                    "math": "-24+40-15=1",
                    "text": "Combine the three signed contributions."
                  }
                ]
              }
            },
            {
              "id": "vector-parts",
              "archetypeId": "structural-method",
              "level": "basic",
              "presentation": "extended",
              "stem": "Use $\\vec{w}=\\begin{pmatrix}2\\\\-3\\\\1\\end{pmatrix}$.",
              "answer": "(a) $2$; (b) $\\sqrt{14}$.",
              "parts": [
                {
                  "label": "a",
                  "prompt": "State the first component.",
                  "finalAnswer": "$2$",
                  "workedSolution": {
                    "steps": [
                      {
                        "id": "first-component",
                        "math": "w_1=2",
                        "text": "Read the top entry."
                      }
                    ]
                  }
                },
                {
                  "label": "b",
                  "prompt": "Find the magnitude.",
                  "finalAnswer": "$\\sqrt{14}$",
                  "workedSolution": {
                    "steps": [
                      {
                        "id": "magnitude",
                        "math": "|\\vec{w}|=\\sqrt{2^2+(-3)^2+1^2}=\\sqrt{14}",
                        "text": "Take the square root of the sum of the squared components."
                      }
                    ]
                  }
                }
              ]
            },
            {
