                  "id": "calculus-method",
                  "label": "Worked example",
                  "tabLabel": "Calculus and series",
                  "prompt": "Evaluate $\\int_{0}^{2}(3x^2-4x+1)\\,dx$ using an antiderivative.",
                  "solutionLayout": "paired-table",
                  "steps": [
                    {
                      "id": "antiderivative",
                      "math": "$F(x)=x^3-2x^2+x$",
                      "text": "Integrate each polynomial term. An arbitrary constant cancels in the endpoint difference."
                    },
                    {
                      "id": "endpoints",
                      "math": "$\\int_{0}^{2}(3x^2-4x+1)\\,dx=F(2)-F(0)=2$",
                      "text": "Subtract the lower endpoint value from the upper endpoint value."
                    }
                  ],
                  "answer": "$2$",
                  "practice": {
                    "instructions": "Complete the questions in your exercise book or the authored workbook. This is an audit fixture."
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "practice-calculus",
          "title": "Practice: Calculus and finite series",
          "practiceCollectionId": "collection-calculus",
          "questions": [
            {
              "id": "integral",
              "archetypeId": "calculus-method",
              "level": "basic",
              "presentation": "extended",
              "stem": "Evaluate $\\int_{0}^{2}x\\,dx$.",
              "answer": "$2$",
              "workedSolution": {
                "steps": [
                  {
                    "id": "integral-step-0",
                    "math": "F(x)=\\frac{x^2}{2}",
                    "text": "Use an antiderivative of x."
                  },
                  {
                    "id": "integral-step-1",
                    "math": "\\int_{0}^{2}x\\,dx=F(2)-F(0)=2",
                    "text": "Subtract endpoint values in the authored order."
                  }
                ]
              }
            },
            {
              "id": "indefinite",
              "archetypeId": "calculus-method",
              "level": "basic",
              "presentation": "extended",
              "stem": "Find an antiderivative: $\\int 2x\\,dx$.",
              "answer": "$x^2+C$",
              "workedSolution": {
                "steps": [
                  {
                    "id": "indefinite-step-0",
                    "math": "\\int 2x\\,dx=x^2+C",
                    "text": "Include an arbitrary constant for the family of antiderivatives."
                  }
                ]
              }
            },
            {
              "id": "limit",
              "archetypeId": "calculus-method",
              "level": "basic",
              "presentation": "extended",
              "stem": "Evaluate $\\lim_{x\\to3}\\frac{x^2-9}{x-3}$.",
              "answer": "$6$",
              "workedSolution": {
                "steps": [
                  {
                    "id": "limit-step-0",
                    "math": "\\frac{x^2-9}{x-3}=x+3",
                    "text": "For x not equal to 3, factor and cancel."
                  },
                  {
                    "id": "limit-step-1",
                    "math": "\\lim_{x\\to3}\\frac{x^2-9}{x-3}=6",
                    "text": "The limit concerns nearby values, not direct substitution into zero over zero."
                  }
                ]
              }
            },
            {
              "id": "sum",
              "archetypeId": "calculus-method",
              "level": "basic",
              "presentation": "extended",
              "stem": "Evaluate $\\sum_{k=1}^{5}k^2$.",
              "answer": "$55$",
              "workedSolution": {
                "steps": [
                  {
                    "id": "sum-step-0",
                    "math": "\\sum_{k=1}^{5}k^2=1+4+9+16+25=55",
                    "text": "Include each integer index from 1 to 5 once."
                  }
                ]
              }
            },
            {
              "id": "product",
              "archetypeId": "calculus-method",
              "level": "basic",
              "presentation": "extended",
              "stem": "Evaluate $\\prod_{k=1}^{4}k$.",
              "answer": "$24$",
              "workedSolution": {
                "steps": [
                  {
                    "id": "product-step-0",
                    "math": "\\prod_{k=1}^{4}k=1\\times2\\times3\\times4=24",
                    "text": "A product multiplies its indexed factors."
                  }
                ]
              }
            },
            {
              "id": "derivative",
              "archetypeId": "calculus-method",
              "level": "basic",
              "presentation": "extended",
              "stem": "For $y=x^4$, find $\\frac{d^2y}{dx^2}$.",
              "answer": "$12x^2$",
              "workedSolution": {
                "steps": [
                  {
                    "id": "derivative-step-0",
                    "math": "\\frac{dy}{dx}=4x^3",
                    "text": "Differentiate once."
                  },
                  {
                    "id": "derivative-step-1",
                    "math": "\\frac{d^2y}{dx^2}=12x^2",
                    "text": "Differentiate again; the order belongs in both numerator and denominator."
                  }
                ]
              }
            },
            {
              "id": "one-sided",
              "archetypeId": "calculus-method",
              "level": "basic",
              "presentation": "extended",
              "stem": "State the one-sided behaviour of $\\frac1x$ near zero.",
              "answer": "(a) $+\\infty$; (b) $-\\infty$.",
              "parts": [
                {
                  "label": "a",
                  "prompt": "Find $\\lim_{x\\to0^{+}}\\frac1x$.",
                  "finalAnswer": "$+\\infty$",
                  "workedSolution": {
                    "steps": [
                      {
                        "id": "right-limit",
                        "math": "\\lim_{x\\to0^{+}}\\frac1x=+\\infty",
                        "text": "For positive x approaching zero, the reciprocal is positive and grows without bound."
                      }
                    ]
                  }
                },
                {
                  "label": "b",
                  "prompt": "Find $\\lim_{x\\to0^{-}}\\frac1x$.",
                  "finalAnswer": "$-\\infty$",
                  "workedSolution": {
                    "steps": [
                      {
                        "id": "left-limit",
                        "math": "\\lim_{x\\to0^{-}}\\frac1x=-\\infty",
                        "text": "For negative x approaching zero, the reciprocal is negative and decreases without bound."
                      }
                    ]
                  }
                }
              ]
            },
            {
              "id": "calculus-choice",
              "archetypeId": "calculus-method",
              "level": "basic",
              "presentation": "extended",
              "stem": "Which expression equals $2$?",
              "choice": {
                "type": "single",
                "options": [
                  {
                    "id": "integral-option",
                    "text": "$\\int_{0}^{2}x\\,dx$"
                  },
                  {
                    "id": "sum-option",
                    "text": "$\\sum_{k=1}^{3}k$"
                  },
                  {
                    "id": "product-option",
                    "text": "$\\prod_{k=1}^{3}k$"
                  }
                ]
              },
              "choiceAnswer": {
                "correctOptionIds": [
                  "integral-option"
                ]
              },
              "workedSolution": {
                "steps": [
                  {
                    "id": "option-integral",
                    "math": "\\int_{0}^{2}x\\,dx=2",
                    "text": "The finite sum and product in B and C each equal 6."
                  }
                ]
              }
            }
          ]
