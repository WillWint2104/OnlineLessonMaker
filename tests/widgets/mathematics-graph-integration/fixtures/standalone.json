              "examples": [
                {
                  "id": "graph-method-example",
                  "label": "Construct and compare",
                  "tabLabel": "Graph methods",
                  "prompt": "Construct the segment for $y=2x+1$, where $-2\\le x\\le2$.",
                  "steps": [
                    {
                      "id": "calculate-endpoints",
                      "math": "$y(-2)=2(-2)+1=-3$\n$y(2)=2(2)+1=5$",
                      "text": "Find the endpoints: substitute each domain endpoint into the equation."
                    },
                    {
                      "id": "plot",
                      "math": "$(-2,-3),\\ (2,5)$",
                      "text": "Plot both endpoints on the axes."
                    },
                    {
                      "id": "join",
                      "math": "$-2\\le x\\le2$",
                      "text": "Join the endpoints with a straight segment. Do not extend beyond them."
                    }
                  ],
                  "answer": "Endpoints $(-2,-3)$ and $(2,5)$, joined only on $-2\\le x\\le2$.",
                  "solutionLayout": "paired-table",
                  "visualRefs": [
                    "demonstration-line"
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "graph-practice",
