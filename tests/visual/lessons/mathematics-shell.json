                }
              ],
              "answer": "(3, 9)"
            },
            {
              "id": "ex-neg3",
              "label": "Starting from _x_ = −3",
              "prompt": "Now find the point where _x_ = −3.",
              "steps": [
                {
                  "id": "s1",
                  "text": "Substitute the negative value.",
                  "math": "_y_ = (−3)^2"
                },
                {
                  "id": "s2",
                  "text": "Evaluate. Squaring removes the sign.",
                  "math": "_y_ = 9"
                }
              ],
              "answer": "(−3, 9)"
            }
          ],
          "relations": [
            {
              "kind": "figure",
              "figure": {
                "type": "figure",
                "figure": "graph",
                "aspect": "stretch",
                "grid": "shown",
                "callouts": "hidden",
                "domain": {
                  "xMin": -6,
                  "xMax": 6,
                  "yMin": -1,
                  "yMax": 11
                },
                "objects": [
                  {
                    "type": "function",
                    "f": "x^2",
                    "label": "y = x^2"
                  },
                  {
                    "type": "line",
                    "x": 0,
                    "label": "axis of symmetry x = 0"
                  },
                  {
                    "type": "line",
                    "y": 9,
                    "label": "y = 9"
                  },
                  {
                    "type": "points",
                    "rows": [
                      [
                        "(−3, 9)",
                        -3,
                        9
                      ],
                      [
                        "(3, 9)",
                        3,
                        9
                      ]
                    ]
                  }
                ]
              }
            },
            {
              "kind": "relations",
              "label": "Why the two agree",
              "items": [
                "The two _x_-values sit at equal distance either side of the _y_-axis, and squaring sends both to the same _y_. That is what makes _x_ = 0 the axis of symmetry."
              ]
            }
          ]
        }
