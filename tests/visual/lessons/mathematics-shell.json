       {
        "kind": "relations",
        "items": [
         "The line _y_ = 16 crosses the curve twice, once each side of the axis."
        ]
       }
      ]
     }
    },
    {
     "id": "ex-symmetry",
     "label": "Example 3",
     "question": "(3, 9) lies on _y_ = _x_^2. Use symmetry to name another point with the same _y_-value.",
     "steps": [
      {
       "id": "s1",
       "text": "The axis of symmetry is the _y_-axis, the line _x_ = 0."
      },
      {
       "id": "s2",
       "text": "Measure the horizontal distance from the axis to the point.",
       "math": "3 − 0 = 3 units right"
      },
      {
       "id": "s3",
       "text": "Reflect that distance to the other side.",
       "math": "0 − 3 = −3"
      },
      {
       "id": "s4",
       "text": "Confirm with the rule rather than by eye.",
       "math": "(−3)^2 = 9"
      }
     ],
     "resultLabel": "Answer",
     "result": "(−3, 9) — the mirror image of (3, 9) in the _y_-axis.",
     "visual": {
