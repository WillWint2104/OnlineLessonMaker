   "lede": "Three problems on _y_ = _x_^2, each worked through in full.",
   "examples": [
    {
     "id": "ex-evaluate",
     "label": "Example 1",
     "question": "Use the rule _y_ = _x_^2 to find _y_ when _x_ = −4.",
     "steps": [
      {
       "id": "s1",
       "text": "Write the rule.",
       "math": "_y_ = _x_^2"
      },
      {
       "id": "s2",
       "text": "Substitute the given value. Keep the brackets — the whole of −4 is squared.",
       "math": "_y_ = (−4)^2"
      },
      {
       "id": "s3",
       "text": "Evaluate. A negative multiplied by a negative gives a positive.",
       "math": "_y_ = −4 × −4 = 16",
       "visual": {
        "kind": "points",
        "label": "Both signs land on the same y",
        "items": [
         {
          "term": "(−4, 16)"
         },
         {
          "term": "(4, 16)"
         }
        ]
       }
      }
     ],
     "resultLabel": "Answer",
     "result": "_y_ = 16, so (−4, 16) lies on the graph.",
     "visual": {
      "parts": [
       {
        "kind": "table",
        "label": "Substitution",
        "stub": "_x_",
        "head": [
         "−4",
         "−2",
         "0",
         "2",
         "4"
        ],
        "rows": [
         {
          "label": "_y_ = _x_^2",
          "cells": [
           "16",
           "4",
           "0",
           "4",
           "16"
          ]
         }
        ]
       },
       {
        "kind": "relations",
        "items": [
         "−4 and 4 give the same _y_-value, because squaring removes the sign."
        ]
       }
      ]
     }
    },
    {
     "id": "ex-solve",
     "label": "Example 2",
     "question": "Find the value(s) of _x_ for which _y_ = 16.",
     "steps": [
      {
       "id": "s1",
       "text": "Substitute the known _y_-value into the rule.",
       "math": "16 = _x_^2"
      },
      {
       "id": "s2",
       "text": "Take the square root of both sides. A positive number has two square roots.",
       "math": "_x_ = ±4"
      },
      {
       "id": "s3",
       "text": "Check both against the rule.",
       "math": "4^2 = 16 and (−4)^2 = 16"
      },
      {
       "id": "s4",
       "text": "Read it off the graph: the line _y_ = 16 crosses the parabola twice, once each side of the axis."
      }
     ],
     "resultLabel": "Answer",
     "result": "_x_ = 4 or _x_ = −4.",
     "visual": {
      "parts": [
       {
        "kind": "figure",
        "figure": {
         "type": "figure",
         "figure": "graph",
