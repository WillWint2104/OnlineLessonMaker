   "title": "Exploring the graph of _y_ = _x_^2",
   "lede": "A quadratic function with a U-shaped curve.",
   "keyIdea": {
    "title": "Key idea",
    "body": "Opposite _x_-values give the same _y_-value: if _x_ = _a_, then _x_ = −_a_ gives the same _y_."
   },
   "contentTitle": "Key concepts",
   "workspace": {
    "kind": "representation"
   },
   "concepts": [
    {
     "id": "shape",
     "term": "Shape",
     "body": "The graph of _y_ = _x_^2 is a parabola that opens upwards."
    },
    {
     "id": "vertex",
     "term": "Vertex",
     "body": "The vertex is at (0, 0), which is the lowest point on the graph."
    },
    {
     "id": "symmetry",
     "term": "Axis of symmetry",
     "body": "The graph is symmetrical about the _y_-axis."
    },
    {
     "id": "yvalues",
     "term": "_y_-values",
     "body": "All _y_-values are zero or positive (_y_ ≥ 0). Opposite _x_-values give the same _y_-value."
    }
   ],
