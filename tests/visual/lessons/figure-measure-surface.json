    {
      "type": "page",
      "title": "One surface, many formats",
      "blocks": [
        {
          "type": "section",
          "title": "One surface, many formats",
          "flow": [
            {
              "kind": "para",
              "text": "A decimal with a unit, a different unit, an algebraic measure, and an AREA unit. The area unit is a RENDERER FORMAT STRESS CASE ONLY — see the caption."
            }
          ]
        },
        {
          "type": "figure",
          "figure": "geometry",
          "title": "Mixed measurement formats",
          "caption": "STRESS FIXTURE, NOT A PEDAGOGICAL EXAMPLE. \"12 cm²\" is here to prove the chip typesets a superscripted unit and sizes it correctly. An AREA unit on a SIDE is mathematically wrong and must never be copied into a real lesson; a side length is a length. The other three sides are valid measures.",
          "objects": [
            {
              "type": "points",
              "from": "table",
              "rows": [
