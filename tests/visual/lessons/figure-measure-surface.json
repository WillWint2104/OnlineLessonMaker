                "C"
              ]
            },
            {
              "type": "rightAngle",
              "at": "A",
              "between": [
                "B",
                "C"
              ]
            },
            {
              "type": "sideLabel",
              "between": [
                "B",
                "C"
              ],
              "text": "hypotenuse",
              "label": "measure"
            },
            {
              "type": "sideLabel",
